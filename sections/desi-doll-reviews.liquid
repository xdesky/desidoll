{% comment %}
  Add the Judge.me Happy Customers (Paid) app block to this section in Theme Editor.
  Enable the Judge.me app embed. The app block supplies live reviews and its
  review submission control. Review Snippets can be used on a free plan, but
  it is a carousel and may not provide a review submission form here.
{% endcomment %}
<section id="desidoll-reviews" class="dd-reviews-app" aria-label="Customer reviews">
  <div class="dd-reviews-app__inner">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when '@app' %}
          {% render block %}
      {% endcase %}
    {% endfor %}
    {% if section.blocks.size == 0 and request.design_mode %}
      <p class="dd-reviews-app__hint">Add the Judge.me Happy Customers app block here to show live customer reviews.</p>
    {% endif %}
  </div>
</section>
<style>
  .dd-reviews-app { padding: clamp(36px, 5vw, 80px) 0 clamp(72px, 8vw, 112px); background: #fff; scroll-margin-top: 100px; }
  .dd-reviews-app__inner { width: min(1200px, calc(100% - 40px)); margin: 0 auto; }
  .dd-reviews-app__hint { padding: 28px; border: 1px dashed #dd9dbd; border-radius: 20px; text-align: center; }
</style>
{% schema %}
{
  "name": "Desi Doll live reviews",
  "tag": "div",
  "class": "desi-doll-live-reviews",
  "blocks": [{ "type": "@app" }],
  "max_blocks": 1,
  "presets": [{ "name": "Desi Doll live reviews" }]
}
{% endschema %}
